{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guy Fights mod manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "name",
    "author",
    "version",
    "description",
    "compatibility",
    "tags",
    "changes"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "$ref": "#/$defs/version"
        },
        "maximum": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*|x)$"
        }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "changes": {
      "type": "object",
      "description": "Reserved for supported declarative mod API operations. Only a no-op is currently defined.",
      "properties": {},
      "additionalProperties": false
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
